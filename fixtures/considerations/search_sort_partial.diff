+def search_users(request):
+    q = request.args.get("q", "")
+    sort = request.args.get("sort", "email")
+    # The search term is bound as a parameter; the sort column comes straight
+    # from the query string.
+    rows = db.execute(
+        f"SELECT id, email FROM users WHERE email LIKE ? ORDER BY {sort}",
+        (f"%{q}%",),
+    ).fetchall()
+    log.info("searched users", extra={"result_count": len(rows)})
+    return jsonify(rows)
