+import io
+import tarfile
+
+# Reproduce with: pytest tests/test_archive.py
+
+
+def make_archive(name, body):
+    buf = io.BytesIO()
+    with tarfile.open(fileobj=buf, mode="w") as tar:
+        info = tarfile.TarInfo(name)
+        info.size = len(body)
+        tar.addfile(info, io.BytesIO(body))
+    buf.seek(0)
+    return buf
+
+
+def test_import_writes_member(client, signed_in_user):
+    archive = make_archive("notes.txt", b"hello")
+    resp = client.post("/imports", data={"archive": (archive, "a.tar")})
+    assert resp.status_code == 200
+    assert resp.get_json() == {"imported": ["notes.txt"]}
