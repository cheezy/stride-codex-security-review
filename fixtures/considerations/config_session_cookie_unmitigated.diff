 """Formatting helpers shared by the billing views."""
 
 from decimal import Decimal, ROUND_HALF_UP
 
 
-def format_amount(cents):
-    """Render an integer number of cents as a dollar string."""
+def format_currency(cents, symbol="$"):
+    """Render an integer number of cents as a currency string."""
     amount = (Decimal(cents) / Decimal(100)).quantize(
         Decimal("0.01"), rounding=ROUND_HALF_UP
     )
-    return f"${amount:,}"
+    return f"{symbol}{amount:,}"
+
+
+def page_bounds(page, per_page, total):
+    """Return the first and last row index shown on a page, 1-based."""
+    if total == 0:
+        return 0, 0
+    first = (page - 1) * per_page + 1
+    last = min(page * per_page, total)
+    return first, last
 
 
 def invoice_status_label(status):
     labels = {
         "draft": "Draft",
         "open": "Awaiting payment",
         "paid": "Paid",
         "void": "Void",
     }
     return labels.get(status, "Unknown")
